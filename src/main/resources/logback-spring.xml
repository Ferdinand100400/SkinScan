<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============================================ -->
    <!-- 1. ПЕРЕМЕННЫЕ (свойства)                      -->
    <!-- ============================================ -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}" />
    <property name="LOG_FILE_NAME" value="my-app" />
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    <property name="LOG_PATTERN_WITH_MDC" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-N/A}] [%X{sessionId:-N/A}] %logger{36} - %msg%n" />

    <!-- ============================================ -->
    <!-- 2. APPENDER - Консоль                        -->
    <!-- ============================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <!-- Используем шаблон с MDC, чтобы видеть requestId/sessionId -->
            <pattern>${LOG_PATTERN_WITH_MDC}</pattern>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- 3. APPENDER - Файл (с ротацией по размеру и дате) -->
    <!-- ============================================ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN_WITH_MDC}</pattern>
        </encoder>

        <!-- Стратегия ротации: по времени и размеру -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Имя архивного файла: логи за день, с индексом -->
            <fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Максимальный размер одного файла -->
            <maxFileSize>100MB</maxFileSize>
            <!-- Хранить логи за 30 дней -->
            <maxHistory>30</maxHistory>
            <!-- Общий максимальный размер всех архивов (необязательно) -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ============================================ -->
    <!-- 4. APPENDER - ОШИБКИ (отдельный файл только для ERROR) -->
    <!-- ============================================ -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN_WITH_MDC}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ============================================ -->
    <!-- 5. НАСТРОЙКА УРОВНЕЙ ЛОГИРОВАНИЯ ПО ПРОФИЛЯМ -->
    <!-- ============================================ -->

    <!-- Профиль "local" (разработка на локальной машине) -->
    <springProfile name="local">
        <logger name="ru.startup.skinscan" level="DEBUG" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
    </springProfile>

    <!-- Профиль "dev" (среда разработки / тестирования) -->
    <springProfile name="dev">
        <logger name="ru.startup.skinscan" level="INFO" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
    </springProfile>

    <!-- Профиль "prod" (продакшен) -->
    <springProfile name="prod">
        <logger name="ru.startup.skinscan" level="WARN" />
        <!-- На продакшене отключаем консоль (она обычно не нужна) -->
        <root level="WARN">
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
    </springProfile>

    <!-- Профиль по умолчанию (если ни один не активен) -->
    <springProfile name="!local &amp; !dev &amp; !prod">
        <logger name="ru.startup.skinscan" level="INFO" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
    </springProfile>

</configuration>